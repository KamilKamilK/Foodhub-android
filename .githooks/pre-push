#!/bin/sh
# Full quality gate run locally before every `git push`, mirroring
# .github/workflows/android-quality.yml so a broken build is caught here, not on CI.
#
# Enabled via `git config core.hooksPath .githooks`. Skip once with
# `git push --no-verify` (do not skip a genuine failure -- fix it and re-run).

set -e

cd "$(git rev-parse --show-toplevel)"

echo "==> pre-push: ktlintCheck"
./gradlew --quiet ktlintCheck

echo "==> pre-push: detekt"
./gradlew --quiet detekt

echo "==> pre-push: unit tests"
./gradlew --quiet testDebugUnitTest

echo "==> pre-push: assembleDebug"
./gradlew --quiet assembleDebug

# Compiles the androidTest source set and its Hilt component -- catches a
# DI graph broken only for @HiltAndroidTest (e.g. a TestInstallIn module
# missing a @Provides the real module has) without needing an emulator,
# which the full android-quality.yml `instrumented-tests` job (KVM +
# connectedDebugAndroidTest) is otherwise the only thing that runs.
echo "==> pre-push: assembleDebugAndroidTest"
./gradlew --quiet assembleDebugAndroidTest

echo "==> pre-push: all checks passed"
